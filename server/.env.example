# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---- MongoDB ----
# Dev cluster/database must be separate from prod
MONGODB_URI=mongodb://127.0.0.1:27017/verso_dev

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ---- Cloudinary (uploads routed through Express) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- CORS ----
CORS_ORIGINS=*

# ---- Logging ----
LOG_LEVEL=info
